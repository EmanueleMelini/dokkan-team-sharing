<?xml version="1.0" encoding="utf-8"?>
<!-- English UI (default). The Italian translation is in values-it/strings.xml. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <!-- The full name: App info, install dialogs, the settings title. The accessibility service
         keeps the same name, the one users tap in Settings > Accessibility. -->
    <string name="app_name" translatable="false">DokkanTS Category Helper</string>
    <string name="service_label" translatable="false">DokkanTS Category Helper</string>
    <!-- Label of the launcher activity only (home screen, recent apps): the full name would be cut there. -->
    <string name="launcher_name" translatable="false">Category Helper</string>
    <string name="service_description">Shows a small bubble over Dokkan Battle JP so you can search categories in English and put the Japanese name into the game\'s search field. It only reads which app is in front and the game\'s search field. It goes online only when you tap Check for updates.</string>

    <!-- Service -->
    <string name="section_service">Accessibility service</string>
    <string name="service_status_active">On</string>
    <string name="service_status_not_connected">Enabled in the settings but not connected: turn it off and on again</string>
    <string name="service_status_disabled">Off: without the service the bubble does not appear</string>
    <string name="open_accessibility_settings">Open accessibility settings</string>

    <string name="section_restricted">Android 13+: restricted settings</string>
    <string name="restricted_instructions">If you installed the APK from a file (file manager, browser), Android blocks the accessibility service. Try to turn it on once, then: App info → ⋮ menu at the top right → “Allow restricted settings” → confirm, and turn the service on again. With “adb install” the block usually does not show up.</string>
    <string name="open_app_info">Open app info</string>

    <!-- Appearance -->
    <string name="section_appearance">Visibility</string>
    <string name="auto_show">Show the bubble when Dokkan is open</string>
    <string name="target_package">Package of the app to watch</string>
    <string name="target_package_blank">Empty: Dokkan JP is used</string>
    <string name="installed_apps">Installed Dokkan apps</string>
    <string name="installed_none">No Dokkan app installed.</string>
    <string name="installed_chip" translatable="false">%1$s · %2$s</string>
    <string name="kind_jp" translatable="false">JP</string>
    <string name="kind_global" translatable="false">Global</string>
    <string name="kind_other">other</string>

    <!-- Bubble -->
    <string name="section_bubble">Bubble</string>
    <string name="bubble_opacity">Opacity: %1$d%%</string>
    <string name="bubble_size">Size: %1$d dp</string>
    <string name="bubble_reset_position">Move the bubble back to the right edge</string>
    <string name="bubble_hint">Drag the bubble anywhere: it snaps to the nearest edge and keeps its position. It turns solid while you touch it.</string>

    <!-- Diagnostics -->
    <string name="section_diagnostics">Diagnostics</string>
    <string name="debug_log">Diagnostic log</string>
    <string name="debug_log_help">Writes to Logcat which app is in front and which fields get the focus in Dokkan. To read it from a computer:</string>
    <string name="debug_log_command" translatable="false">adb logcat -s DokkanHelper</string>

    <!-- Insertion -->
    <string name="section_insert">Insertion</string>
    <string name="insert_auto">Automatic: types the name into the game\'s search field</string>
    <string name="insert_clipboard">Clipboard only: you paste it</string>
    <string name="insert_hint">Either way the name also goes to the clipboard. In automatic mode, tap the game\'s search field within 30 seconds of your pick: while the name is waiting, the bubble stays solid with a white ring. If the field was already open, the name goes in right away.</string>
    <string name="insert_failed">Could not type the name: paste it yourself, it is on the clipboard</string>

