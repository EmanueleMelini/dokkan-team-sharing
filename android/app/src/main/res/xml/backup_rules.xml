<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 11: the same rules as data_extraction_rules.xml (Android 12 and newer ignore this
     file). Everything the app keeps is backed up, except the temporary files of the atomic writes. -->
<full-backup-content>
    <exclude domain="file" path="categories.json.tmp" />
    <exclude domain="file" path="categories.removed.tmp" />
    <exclude domain="file" path="datastore/settings.preferences_pb.tmp" />
</full-backup-content>
