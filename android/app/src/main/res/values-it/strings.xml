<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="it">
    <string name="service_description">Mostra una piccola bolla sopra Dokkan Battle JP per cercare le categorie in inglese e inserirne il nome giapponese nel campo di ricerca del gioco. Legge solo quale app è in primo piano e il campo di ricerca del gioco. Va in rete solo quando tocchi «Controlla aggiornamenti».</string>

    <!-- Service -->
    <string name="section_service">Servizio di accessibilità</string>
    <string name="service_status_active">Attivo</string>
    <string name="service_status_not_connected">Abilitato nelle impostazioni ma non connesso: disattivalo e riattivalo</string>
    <string name="service_status_disabled">Disattivato: senza il servizio la bolla non compare</string>
    <string name="open_accessibility_settings">Apri impostazioni accessibilità</string>

    <string name="section_restricted">Android 13+: impostazioni con restrizioni</string>
    <string name="restricted_instructions">Se hai installato l\'APK da file (file manager, browser), Android blocca il servizio di accessibilità. Prova prima ad attivarlo una volta, poi: Info app → menu ⋮ in alto a destra → «Consenti impostazioni con restrizioni» → conferma, e riattiva il servizio. Con «adb install» di solito il blocco non c\'è.</string>
    <string name="open_app_info">Apri Info app</string>

