    <!-- Insertion -->
    <string name="section_insert">Inserimento</string>
    <string name="insert_auto">Automatico: scrive il nome nel campo di ricerca del gioco</string>
    <string name="insert_clipboard">Solo appunti: lo incolli tu</string>
    <string name="insert_hint">In entrambi i casi il nome va anche negli appunti. In automatico, dopo la scelta tocca il campo di ricerca del gioco entro 30 secondi: finché il nome è in attesa la bolla resta piena, con un bordo bianco. Se il campo era già aperto, il nome entra subito.</string>
    <string name="insert_failed">Inserimento non riuscito: incolla a mano, il nome è negli appunti</string>

