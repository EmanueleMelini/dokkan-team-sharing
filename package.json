{
  "name": "dokkan-team-sharing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "./db/local.sh start",
    "db:stop": "./db/local.sh stop",
    "db:status": "node db/migrate.mjs --status",
    "db:up": "node db/migrate.mjs",
    "db:reset": "node db/reset.mjs",
    "db:test": "./db/test/run.sh",
    "db:fetch": "node db/import/fetch-wiki.mjs && node db/import/fetch-events.mjs && node db/import/fetch-datamine.mjs",
    "db:import": "node db/import/load-cards.mjs && node db/import/load-game-cards.mjs && node db/import/load-events.mjs && node db/import/load-datamine.mjs && node db/import/load-game-events.mjs && node db/import/load-windows.mjs && node db/import/load-missions.mjs && node db/import/load-equipment.mjs && node db/cache-clear.mjs",
    "db:refresh": "node db/reset.mjs && node db/import/load-cards.mjs && node db/import/load-game-cards.mjs && node db/import/load-events.mjs && node db/import/load-datamine.mjs && node db/import/load-game-events.mjs && node db/import/load-windows.mjs && node db/import/load-missions.mjs && node db/import/load-equipment.mjs && node db/import/fetch-assets.mjs && node db/cache-clear.mjs",
    "db:assets": "node db/import/fetch-assets.mjs",
    "db:events": "node db/import/load-events.mjs",
    "db:game-cards": "node db/import/load-game-cards.mjs",
    "db:window": "node db/import/set-event-window.mjs",
    "db:datamine": "node db/import/load-datamine.mjs",
    "db:game-events": "node db/import/load-game-events.mjs",
    "db:windows": "node db/import/load-windows.mjs",
    "db:missions": "node db/import/load-missions.mjs",
    "db:equipment": "node db/import/load-equipment.mjs",
    "db:demo": "node db/seed/demo-clears.mjs && node db/cache-clear.mjs",
    "cache:clear": "node db/cache-clear.mjs",
    "prod:setup": "node db/prod/setup.mjs",
    "prod:update": "node db/prod/update.mjs",
    "prod:backup": "node db/prod/backup.mjs",
    "prod:snapshot": "node db/prod/snapshot.mjs",
    "prod:compare": "node db/prod/compare.mjs",
    "prod:mirror-assets": "node db/prod/mirror-assets.mjs",
    "prod:sanity": "node db/prod/sanity.mjs",
    "assets:deploy": "node scripts/assets-deploy.mjs",
    "db:test:queries": "./db/test/queries.test.sh",
    "test:parametri": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./db/test/alias.mjs db/test/parametri.test.mts",
    "test:smoke": "./test/smoke.sh",
    "test:auth-smoke": "./test/auth-smoke.sh",
    "test:cpu": "./test/cpu.sh"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.32.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
