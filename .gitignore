# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cluster Postgres locale di sviluppo
/db/.pgdata
/db/.pgdata.log

# cache dell'import dal wiki (8.8 MB, si riscarica con npm run db:fetch)
/db/import/.cache

# IDE
/.idea

# immagini scaricate (si riprendono con npm run db:assets)
/public/assets

# copie del database di produzione (npm run prod:backup)
/backups

# la cache della settimana prima, per db/prod/sanity.mjs
/db/import/.cache.prev
